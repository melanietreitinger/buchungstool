        <mxCell id="tGyyIp_9BxudeVWjjhaJ-8" value="&lt;div&gt;Lehrende: Müssen Daten überprüfen oder Aktiv werden&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Ankreuzen des Veranstaltungstyps&lt;/li&gt;&lt;li&gt;Auswählen der Verantwortlichen aus allen Lehrenden mit Tutor-Rechten&lt;/li&gt;&lt;li&gt;Lehrveranstaltung auswählen aus allen LV Bezeichungen aus CM&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=17;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
