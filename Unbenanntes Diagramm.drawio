        <mxCell id="tGyyIp_9BxudeVWjjhaJ-10" value="&lt;div&gt;Nachteil:&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Verantwortung Lehrende&lt;/li&gt;&lt;li&gt;Lehrende müssen aus Auswahl ihre LV/Verantwotliche finden (bei vielen Kursen sehr fehleranfällig)&lt;/li&gt;&lt;li&gt;Lehrende haben keinen Zeitpunkt zu dem sie erinnert werden in Aktion zu treten&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
