        <mxCell id="tGyyIp_9BxudeVWjjhaJ-5" value="Automatisch: Wenn entsprechende Daten über Campussystem vorhanden sind, wird die Verantwortliche Person und die Lehrveranstaltung vorausgefüllt sowie der Lehrveranstaltungstyp erstellt.&amp;nbsp;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=17;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1">
