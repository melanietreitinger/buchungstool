        <mxCell id="TPzt12_0adVEghgGzAgV-4" value="&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;ermöglicht Anlegen weiterer Räume und deren Verwaltung&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;mehr als einWochenplan für Zeitslots kann angelegt werden&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Wochenpläne + Blocker können einem Raum zugeordnet werden&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&quot;Sonderressourcen&quot; können angelegt und in Übersicht verwaltet werden | sie werden in Kategorien organisiert, die ebenfalls angelegt werden können&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Prüfungskurse können bei Bedarf automatisch angelegt werden | dabei können Templates genutzt werden&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;" vertex="1" parent="1">
