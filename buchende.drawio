        <mxCell id="Bh66k2oq9ZSq560NoVIz-1" parent="CCN0DATAm5xw3YuDV8w9-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Die Detailansicht stellt einen alten Stand dar.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&quot;Verantwortliche Person&quot; ist ein Feld, bei dem nur ein User ausgewählt werden kann.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Außerdem gibt es das Feld &quot;Weitere Prüfende&quot;, bei dem mehrere User ausgewählt werden können.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Die Felder zu &quot;Nachteilsausgleich&quot; und &quot;Aufsichtsperson(en)&quot; können getilgt werden, um das Formular zu verschlanken und weil solche Angaben zum Zeitpunkt der Buchungsanfrage in der Regel nicht bekannt sind oder im Falle der Aufsichten im Detail nicht relevant sind.&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="360" width="240" x="30" y="2540" as="geometry" />
        </mxCell>
