        <mxCell id="Vvvzto3dPd8JCJAF0X1m-19" value="&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div align=&quot;left&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Weitere Prüfungsräume und Ausstattung, Prüfungskurse&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;div align=&quot;left&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Kalender:&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Zusätzliche Filteroption im Kalender: Räume&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Buchungsformular:&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Ergänzung um &lt;i&gt;Raumauswahl&lt;/i&gt; (ggf. mit verschiedenen Wochenplänen) und &lt;i&gt;Auslastung&lt;/i&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Zusätzliche &lt;i&gt;Ressourcen&lt;/i&gt;, wie Software, Hardware, Barrierefreier Arbeitsplatz, ...&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;i&gt;Prüfungskurse&lt;/i&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Adminkonfiguration:&lt;/b&gt;&lt;/font&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Anlegen &lt;i&gt;weiterer Räume&lt;/i&gt; und deren Verwaltung&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;i&gt;Auslastung/Auslastungsverteilung &lt;/i&gt;für Räume&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;i&gt;Weitere Wochenpläne&lt;/i&gt;, die einem oder mehreren Räumen zugeordnet werden können (Admin)&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;i&gt;Farbverwaltung&lt;/i&gt;: Farben können einem Raum zugewiesen werden&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&quot;&lt;i&gt;Sonderressourcen&lt;/i&gt;&quot; und Ressourcenkategorien (z.B. Software, Hardware, Raumausstattung)&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Orga Kurstemplates und Zuordnung zu Einrichtungen (Kurskategorien)&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Prüfungskurse: Auf Anforderung im Buchungsformular&lt;/b&gt; können automatisch &lt;i&gt;Prüfungskurse&lt;/i&gt;&amp;nbsp;(auf Basis von Kurstemplates) angelegt werden.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;sketch=1;curveFitting=1;jiggle=2;align=left;" vertex="1" parent="Vvvzto3dPd8JCJAF0X1m-9">
