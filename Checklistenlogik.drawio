        <mxCell id="rfoc4b0ECouwkWK_uI7O-377" value="Die agierende Rolle ist Prüfende*r --&amp;gt; es soll eine Checkliste für Prüfende*r erstellt werden --&amp;gt; Es werden nur Checklistepunkte übernommen, die als Verantwortlich Prüfende*r gelistet haben" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fillStyle=solid;direction=west;gradientDirection=north;shadow=1;size=20;pointerEvents=1;fontColor=#333333;" vertex="1" parent="1">
